FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql://postgres:senha@<seu-projeto>.supabase.co:5432/postgres
# Para usar SQLite local, deixe DATABASE_URL vazio ou remova a linha acima.
CORS_ORIGINS=http://localhost:5173
PORT=5000

# --- E-mail (SMTP) ---
# Sem essas variáveis, os e-mails só são registrados no log (modo dev).
# Exemplo usando Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=seuemail@gmail.com
SMTP_FROM_NAME=Agenda
SMTP_USE_TLS=true

# --- Push Notification (Web Push) — opcional ---
# Gere um par de chaves VAPID (ex: `npx web-push generate-vapid-keys`) e instale `pywebpush`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- SMS (Twilio) — opcional ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- WhatsApp (Cloud API / Meta) — opcional ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
